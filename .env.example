# Local development only. Replace passwords before exposing services.

# Metadata PostgreSQL database (docker-compose "postgres-meta" service).
# Belt stores workflows, connections, and run history here.
META_DB_HOST=postgres-meta
META_DB_PORT=5432
META_DB_NAME=belt_db
META_DB_USER=postgres
META_DB_PASSWORD=change-this-local-password

# Host port that maps to the frontend container's port 80 (docker-compose.yml).
FRONTEND_PORT=80

# Backend runtime mode (backend/auth.py). Outside "production"/"prod",
# OIDC_REQUIRED is allowed to be false; in production OIDC_REQUIRED=true is enforced.
APP_ENV=development

# Controls which transfer-package features are allowed, independent of the
# BELT_TRANSFER_*_ENABLED flags below (backend/routers/transfer_packages.py):
# DEV allows import/export/export-creation, TEST allows import/export,
# PROD allows import only. Use DEV, TEST, or PROD.
BELT_ENVIRONMENT=DEV

# Exposes the FastAPI docs (/docs, /redoc) when true (backend/main.py).
BELT_API_DOCS_ENABLED=false

# Key used to encrypt/decrypt saved connection secrets (backend/secret_crypto.py,
# via cryptography.Fernet). Generate with `openssl rand -base64 32`. Keep it
# private and stable: rotating it makes previously encrypted secrets unreadable.
BELT_CONNECTION_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# Python executable and route script the backend spawns as a subprocess to run
# workflow routes (backend/main.py).
PYTHON_EXECUTABLE=python
ROUTE_SCRIPT_PATH=/app/myetl/parser/route.py

# Redis URLs Celery uses as message broker and result backend, and how long
# (in seconds) task results are kept (worker/celery_app.py).
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_RESULT_EXPIRES=432000

# Keycloak service settings (docker-compose.yml). Keycloak is started locally
# but no Belt realm/client is provisioned automatically; OIDC is disabled by
# default (see OIDC_REQUIRED below).
KEYCLOAK_DB_PASSWORD=change-this-local-password
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-local-password
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_PORT=8080

# Frontend (Create React App) OIDC settings. These are embedded into the
# frontend at build time, so set them before `docker compose up --build`.
REACT_APP_OIDC_REQUIRED=false
REACT_APP_OIDC_ISSUER_URL=
REACT_APP_OIDC_CLIENT_ID=
REACT_APP_OIDC_REDIRECT_URI=
REACT_APP_OIDC_SCOPE=openid profile email

# Backend OIDC token verification (backend/auth.py). OIDC_REQUIRED=false is
# only accepted when APP_ENV is not "production"/"prod"; if true, OIDC_ISSUER_URL
# and OIDC_CLIENT_ID must also be set.
OIDC_REQUIRED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_JWKS_URL=

# Feature flags for the transfer-package API (backend/routers/transfer_packages.py).
# Each flag only takes effect if also allowed for the current BELT_ENVIRONMENT
# (see above): BELT_TRANSFER_EXPORT_CREATION_ENABLED is DEV-only, and
# BELT_TRANSFER_EXPORT_ENABLED is DEV/TEST-only.
BELT_TRANSFER_IMPORT_ENABLED=true
BELT_TRANSFER_EXPORT_ENABLED=true
BELT_TRANSFER_EXPORT_CREATION_ENABLED=true
